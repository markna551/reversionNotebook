    {
      "title": "Crate View",
      "text": "%pyspark\n\nimport datetime\n\n# Auto-generate table and path\nbase_table_name \u003d \"asset\"\ntimestamp \u003d datetime.datetime.now().strftime(\"%Y%m%d_%H%M%S\")\ntable_name \u003d f\"{table_base_name}_{short_id}\"\nlocation_path \u003d f\"file:/data/zeus/store/{table_name}\"\n\n# Create table SQL\ncreate_table_sql \u003d f\"\"\"\nCREATE TABLE IF NOT EXISTS {table_name} (\n  id STRING,\n  first_name STRING,\n  last_name STRING,\n  email STRING,\n  gender STRING,\n  create_date STRING\n)\nUSING delta\nOPTIONS (\n  \u0027isEncryptData\u0027 \u003d \u0027false\u0027\n)\nTBLPROPERTIES (\n  \u0027delta.minReaderVersion\u0027 \u003d \u00271\u0027,\n  \u0027delta.minWriterVersion\u0027 \u003d \u00272\u0027\n)\nLOCATION \u0027{location_path}\u0027\n\"\"\"\n\n# Create or replace view SQL\nview_name \u003d \"default.asset_view_latest\"\ncreate_view_sql \u003d f\"\"\"\nCREATE OR REPLACE VIEW {view_name} (\n  id,\n  first_name,\n  last_name,\n  email,\n  gender,\n  create_date\n) AS SELECT * FROM {table_name}\n\"\"\"\n\n# Execute both SQLs\nspark.sql(create_table_sql)\nspark.sql(create_view_sql)\n\n# Print confirmation\nprint(f\"✅ Table created: {table_name}\")\nprint(f\"📁 Location: {location_path}\")\nprint(f\"👁️ View created: {view_name} (pointing to {table_name})\")\n\n\n\nprint(f\"✅ Drop table: {table_name}\")\n\nsql_drop \u003d f\"DROP TABLE IF EXISTS {table_name}\"\n\nspark.sql(sql_drop)\n",
      "user": "anonymous",
      "dateUpdated": "2025-08-01 16:05:50.983",
      "progress": 0,
