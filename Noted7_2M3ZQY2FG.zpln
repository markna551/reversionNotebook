    {
      "title": "CRUD",
      "text": "%pyspark\nimport datetime\n\n# สร้างชื่อ table และ path อัตโนมัติ\nbase_table_name \u003d \"asset\"\ntimestamp \u003d datetime.datetime.now().strftime(\"%Y%m%d_%H%M%S\")\ntable_name \u003d f\"{table_base_name}_{short_id}\"\nlocation_path \u003d f\"file:/data/zeus/store/{table_name}\"\n\n# SQL สำหรับสร้างตาราง\nsql_create \u003d f\"\"\"\nCREATE TABLE IF NOT EXISTS {table_name} (\n  id STRING,\n  first_name STRING,\n  last_name STRING,\n  email STRING,\n  gender STRING,\n  create_date STRING\n)\nUSING delta\nOPTIONS (\n  \u0027isEncryptData\u0027 \u003d \u0027false\u0027\n)\nLOCATION \u0027{location_path}\u0027\n\"\"\"\n\n# SQL สำหรับ insert, update, delete\nsql_insert \u003d f\"\"\"\nINSERT INTO {table_name} VALUES\n  (\u00271\u0027, \u0027Anna\u0027, \u0027Sharp\u0027, \u0027anna.s@gmail.com\u0027, \u0027Female\u0027, \u00272025-07-11\u0027),\n  (\u00272\u0027, \u0027John\u0027, \u0027Doe\u0027, \u0027john.doe@example.com\u0027, \u0027Male\u0027, \u00272025-07-10\u0027)\n\"\"\"\n\nsql_update \u003d f\"\"\"\nUPDATE {table_name}\nSET email \u003d \u0027anna.updated@gmail.com\u0027\nWHERE id \u003d \u00271\u0027\n\"\"\"\n\nsql_delete \u003d f\"\"\"\nDELETE FROM {table_name}\nWHERE id \u003d \u00272\u0027\n\"\"\"\n\n# 🛠️ Execute each SQL step\nspark.sql(sql_create)\nspark.sql(sql_insert)\nspark.sql(sql_update)\nspark.sql(sql_delete)\n\n# 📢 แสดงผล\nprint(f\"✅ Table created: {table_name}\")\nprint(f\"📁 Location: {location_path}\")\nprint(\"🚀 Inserted 2 records\")\nprint(\"✏️ Updated 1 record\")\nprint(\"🗑️ Deleted 1 record\")\n\n\nprint(f\"✅ Drop table: {table_name}\")\n\nsql_drop \u003d f\"DROP TABLE IF EXISTS {table_name}\"\n\nspark.sql(sql_drop)\n",
      "user": "anonymous",
      "dateUpdated": "2025-08-01 16:05:50.983",
