    {
      "title": "Crate Internal ,Delta",
      "text": "%pyspark\nimport datetime\nimport uuid\nshort_id \u003d uuid.uuid4().hex[:5]\nprint(short_id)\n# ตั้งชื่อ table และ path อัตโนมัติตามเวลา\ntable_base_name \u003d \"asset\"\ntimestamp_str \u003d datetime.datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n\ntable_name \u003d f\"{table_base_name}_{short_id}\"\nlocation_path \u003d f\"file:/data/zeus/store/{table_name}\"\n\n# Generate SQL string\nsql_create \u003d f\"\"\"\nCREATE TABLE IF NOT EXISTS {table_name} (\n  id STRING,\n  first_name STRING,\n  last_name STRING,\n  email STRING,\n  gender STRING,\n  create_date STRING\n)\nUSING parquet\nOPTIONS (\n  \u0027isEncryptData\u0027 \u003d \u0027false\u0027)\nLOCATION \u0027{location_path}\u0027\n\"\"\"\n# ✅ รัน SQL เพื่อสร้าง table\nspark.sql(sql_create)\n\n# แสดง SQL ที่ได้ (หรือส่งไป execute ต่อ)\nprint(\"Generated SQL:\\n\", sql_create)\n\n#--------------------------------------------------------------------------------------------------------------\n\n# Auto-generate table name and path with timestamp\nbase_table_name \u003d \"asset\"\ntimestamp \u003d datetime.datetime.now().strftime(\"%Y%m%d_%H%M%S\")\ntable_name \u003d f\"{table_base_name}_{short_id}\"\nlocation_path \u003d f\"file:/data/zeus/store/{table_name}\"\n\n# Generate SQL command\nsql_command \u003d f\"\"\"\nCREATE TABLE IF NOT EXISTS {table_name} (\n  id STRING,\n  first_name STRING,\n  last_name STRING,\n  email STRING,\n  gender STRING,\n  create_date STRING\n)\nUSING delta\nOPTIONS (\n  \u0027isEncryptData\u0027 \u003d \u0027false\u0027\n)\nTBLPROPERTIES (\n  \u0027delta.minReaderVersion\u0027 \u003d \u00271\u0027,\n  \u0027delta.minWriterVersion\u0027 \u003d \u00272\u0027\n)\nLOCATION \u0027{location_path}\u0027\n\"\"\"\n# ✅ Execute the SQL to create the table\nspark.sql(sql_command)\n\n# Output table name and path\nprint(f\"✅ Created table: {table_name}\")\nprint(f\"📁 Location: {location_path}\")\n#--------------------------------------------------------------------------------------------------------------\n\n\nprint(f\"✅ Drop table: {table_name}\")\n\nsql_drop \u003d f\"DROP TABLE IF EXISTS {table_name}\"\n\nspark.sql(sql_drop)\n\n",
      "user": "anonymous",
      "dateUpdated": "2025-08-01 16:05:50.982",
      "progress": 0,
