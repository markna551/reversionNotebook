    {
      "title": "schema table \u0026 drop",
      "text": "%pyspark\n\nimport datetime\n\nschema_name \u003d \"abc\"\nbase_table_name \u003d \"asset\"\ntimestamp \u003d datetime.datetime.now().strftime(\"%Y%m%d_%H%M\")\ntable_name_only \u003d f\"{table_base_name}_{short_id}\"\nfull_table_name \u003d f\"{schema_name}.{table_name_only}\"\n\nlocation_path \u003d f\"file:/data/zeus/store/_scm_{schema_name}/{table_name_only}\"\n\nsql_create \u003d f\"\"\"\nCREATE TABLE {full_table_name} (\n  id STRING,\n  first_name STRING,\n  last_name STRING,\n  email STRING,\n  gender STRING,\n  create_date STRING\n)\nUSING parquet\nOPTIONS (\n  \u0027isEncryptData\u0027 \u003d \u0027false\u0027\n)\nLOCATION \u0027{location_path}\u0027\n\"\"\"\n\nsql_drop \u003d f\"DROP TABLE IF EXISTS {full_table_name}\"\n\n# ✅ Run SQL commands\nspark.sql(sql_drop)\nspark.sql(sql_create)\n\n# ✅ Show info\nprint(f\"✅ Created and Dropped table: {full_table_name}\")\nprint(f\"📁 Location was: {location_path}\")\n",
