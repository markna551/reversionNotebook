    {
      "text": "%pyspark\n\nfor doc in docs:\n doc.metadata[\u0027content\u0027] \u003d doc.page_content\n\ndoc_df \u003d spark.createDataFrame([doc.metadata for doc in docs])\n\n# Clean text\ndoc_df \u003d spark.createDataFrame(\n    doc_df.rdd.mapPartitions(clean_text),\n    schema\u003dStructType([\n        StructField(\"id\", StringType()),\n        StructField(\"source\", StringType()),\n        StructField(\"title\", StringType()),\n        StructField(\"when\", StringType()),\n        StructField(\"content\", StringType()),\n    ])\n)\n\n# Split docs into chunks\ndoc_df \u003d spark.createDataFrame(\n    doc_df.rdd.mapPartitions(partial(split_doc, chunk_size\u003dchunk_size, chunk_overlap\u003dchunk_overlap)),\n    schema\u003dStructType([\n        StructField(\"id\", StringType()),\n        StructField(\"source\", StringType()),\n        StructField(\"title\", StringType()),\n        StructField(\"when\", StringType()),\n        StructField(\"chunk_number\", ArrayType(IntegerType())),\n        StructField(\"content\", ArrayType(StringType())),\n    ])\n).select(\n    \u0027id\u0027,\n    \u0027source\u0027,\n    \u0027title\u0027,\n    \u0027when\u0027,\n    F.explode(\u0027chunk_number\u0027).alias(\u0027chunk_number\u0027),\n    F.col(\u0027content\u0027),\n    ).withColumn(\u0027content\u0027, F.col(\u0027content\u0027)[F.col(\u0027chunk_number\u0027)])\n    \n# Vectorize contents\ndoc_df \u003d spark.createDataFrame(\n    doc_df.rdd.mapPartitions(partial(vectorize, dense_model\u003ddense_model)),\n    schema\u003dStructType([\n        StructField(\"id\", StringType()),\n        StructField(\"source\", StringType()),\n        StructField(\"title\", StringType()),\n        StructField(\"when\", StringType()),\n        StructField(\"chunk_number\", IntegerType()),\n        StructField(\"content\", StringType()),\n        StructField(emb_field, ArrayType(FloatType())),\n    ])\n).withColumn(\u0027gtp_timestamp\u0027, F.col(\u0027when\u0027))\\\n    .withColumn(\u0027chunk_number\u0027, F.col(\u0027chunk_number\u0027).cast(\u0027string\u0027))\n\nz.show(doc_df)",
