    {
      "text": "%python\r\nimport blendata_util_py\r\n\r\n#Example2 run parallel with parameter\r\ntimeSleep \u003d 10\r\ntimeout \u003d 300\r\nconcurrentParallel \u003d 1\r\nlanguage \u003d \"python\"\r\nnotebookAddParameterRequest \u003d [\r\n    {\r\n        \"notebookId\": \"2K4G26M8B\",\r\n        \"addParameterMapFromTitle\": {\r\n            \"Title1\": {\r\n                \"a\" : \"round1 work\"\r\n            },\r\n            \"Title2\": {\r\n                \"b\" : 10\r\n            },\r\n            \"Title3\": {\r\n                \"c\": [\"valueA\",\"valueB\",\"valueC\",\"valueD\"]\r\n            },\r\n            \"all\": {\r\n                \"b\": 1.3,\r\n                \"d\": 4.9\r\n            }\r\n        }\r\n    },\r\n    {\r\n        \"notebookId\": \"2K4G26M8B\",\r\n        \"addParameterMapFromTitle\": {\r\n            \"Title1\": {\r\n                \"a\" : \"round2 work\"\r\n            },\r\n            \"Title2\": {\r\n                \"b\": 20\r\n            },\r\n            \"Title3\": {\r\n                \"c\": [10,12,14,15]\r\n            },\r\n            \"all\": {\r\n                \"b\": 5.1,\r\n                \"d\": 4.9\r\n            }\r\n        }\r\n    }\r\n]\r\ndescription \u003d True\r\n\r\nresult  \u003d blendata_util_py.hera_api_runParallelLog(timeSleep,timeout,concurrentParallel,language,notebookAddParameterRequest, description)\r\nprint(result)",
